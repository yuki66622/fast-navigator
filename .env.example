# Fast Navigator sidecar — copy to .env, then: chmod 600 .env
# Without a real key the sidecar runs in offline mock mode (fully functional for demo/tests).
OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_MODEL=deepseek/deepseek-chat
# MOCK_LLM=1        # force mock mode even with a key
# SIDECAR_PORT=8787
